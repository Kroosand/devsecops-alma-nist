#!/usr/bin/env bash
# ==============================================================================
# Proyecto: DevSecOps NIST CSF v2.0 - Alma Industria Creativa E.I.R.L.
# Control: SOP-02 - Control Preventivo Shift-Left en Código (PR.PS-01 / DE.CM-01)
# ==============================================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}[DevSecOps - Shift Left]${NC} Validando código preparado en Staging..."

CONFIG_PATH="01-shift-left/.gitleaks.toml"

if command -v gitleaks &> /dev/null; then
    SCANNER="gitleaks"
elif command -v trufflehog &> /dev/null; then
    SCANNER="trufflehog"
else
    echo -e "${YELLOW}[ADVERTENCIA]${NC} Gitleaks/TruffleHog no encontrado en el PATH."
    echo -e "Instala Gitleaks para habilitar la protección local: winget install Gitleaks.Gitleaks"
    exit 1
fi

if [ "$SCANNER" = "gitleaks" ]; then
    if [ -f "$CONFIG_PATH" ]; then
        gitleaks protect --staged --verbose --redact --config="$CONFIG_PATH"
    else
        gitleaks protect --staged --verbose --redact
    fi
    STATUS=$?

    if [ $STATUS -ne 0 ]; then
        echo -e "\n${RED}===================================================================${NC}"
        echo -e "${RED}[BLOQUEO SHIFT-LEFT] Se detectaron secretos o tokens en el commit!${NC}"
        echo -e "${RED}===================================================================${NC}"
        echo -e "${YELLOW}Acción Correctiva:${NC}"
        echo "1. Remueve las credenciales y trasládalas a la bóveda (Vaultwarden/Vault)."
        echo "2. Usa variables de entorno (.env) que no se suban al repositorio."
        echo "3. Vuelve a ejecutar 'git add <archivo>' y realiza el commit nuevamente.\n"

        # Disparo SOAR a n8n en segundo plano
        python "C:/Sergio/Proyecto Final/devsecops-alma-nist/04-soar-n8n-testing/trigger_alert.py" 1 >/dev/null 2>&1 &

        exit 1
    fi
fi

echo -e "${GREEN}[PASS]${NC} Código limpio de secretos. Commit autorizado."
exit 0
