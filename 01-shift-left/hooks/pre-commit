#!/usr/bin/env bash
# ==============================================================================
# Proyecto: DevSecOps NIST CSF v2.0 - Alma Industria Creativa E.I.R.L.
# Control: SOP-02 - Control Preventivo Shift-Left en Código (PR.PS-01 / DE.CM-01)
# ==============================================================================

set -e

# Determinar la raíz del repositorio dinámicamente
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$REPO_ROOT" ]; then
    REPO_ROOT="."
fi

CONFIG_PATH="$REPO_ROOT/01-shift-left/.gitleaks.toml"
DISPATCHER_SCRIPT="$REPO_ROOT/04-soar-n8n-testing/trigger_alert.py"

if ! command -v gitleaks &> /dev/null; then
    echo "[ADVERTENCIA] Gitleaks no encontrado en el PATH."
    exit 1
fi

trigger_soar_incident() {
    if command -v cygpath &> /dev/null; then
        WIN_SCRIPT=$(cygpath -w "$DISPATCHER_SCRIPT")
    else
        WIN_SCRIPT="$DISPATCHER_SCRIPT"
    fi
    python "$WIN_SCRIPT" 1 2>&1 | grep -E "Despachando incidente|Codigo de Respuesta|Latencia|EXITOSO" || true
}

# Ejecutar Gitleaks con --no-color para compatibilidad con VS Code GUI (Comillas estrictas para rutas con espacios)
GITLEAKS_EXIT=0
if [ -f "$CONFIG_PATH" ]; then
    LEAKS_OUTPUT=$(gitleaks protect --staged --verbose --redact --no-color --config="$CONFIG_PATH" 2>&1) || GITLEAKS_EXIT=$?
else
    LEAKS_OUTPUT=$(gitleaks protect --staged --verbose --redact --no-color 2>&1) || GITLEAKS_EXIT=$?
fi

if [ "$GITLEAKS_EXIT" -ne 0 ]; then
    # El primer mensaje es el que toma la ventana emergente de VS Code
    echo "🛑 [BLOQUEO SHIFT-LEFT] Commit rechazado: Se detectaron credenciales en Staging (SOP-02 / NIST PR.PS-01)"
    echo ""
    echo "==================================================================="
    echo "CONTROL PREVENTIVO DEVSECOPS - ALMA INDUSTRIA CREATIVA E.I.R.L."
    echo "Framework: NIST CSF v2.0 | Subcategoría: PR.PS-01 & DE.CM-01"
    echo "==================================================================="
    echo ""
    echo "$LEAKS_OUTPUT"
    echo ""
    echo "==================================================================="
    echo "ACCIÓN CORRECTIVA SEGÚN SOP-02:"
    echo "1. Remueve las credenciales y trasládalas a la bóveda (Vaultwarden)."
    echo "2. Usa variables de entorno (getenv) que no se suban al repositorio."
    echo "3. Vuelve a ejecutar 'git add' y realiza el commit nuevamente."
    echo "==================================================================="
    echo "[SOAR NIST CSF v2.0] ⚡ Despachando alerta en tiempo real a n8n (Telegram) y SOC Dashboard..."
    trigger_soar_incident
    exit 1
fi

echo "[PASS] Código limpio de secretos. Commit autorizado."
exit 0
