# ==============================================================================
# Variables de entorno de ejemplo para el entorno de laboratorio (Docker Compose)
# Copia este archivo como '.env' en esta misma carpeta y define valores seguros.
# Proyecto: DevSecOps NIST CSF v2.0 - Alma Industria Creativa E.I.R.L.
# ==============================================================================

# HashiCorp Vault - Token de desarrollo/administrador
VAULT_DEV_ROOT_TOKEN_ID=CHANGE_ME

# WordPress - Configuración de Base de Datos
WORDPRESS_DB_NAME=alma_wp_db
WORDPRESS_DB_USER=alma_wp_user
WORDPRESS_DB_PASSWORD=CHANGE_ME

# MySQL - Configuración de Base de Datos y Usuarios
MYSQL_DATABASE=alma_wp_db
MYSQL_USER=alma_wp_user
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
